# TXA code owners - the "Code Owner Review Lock" of STEP 16.
#
# Branch protection on `main` requires at least one approving review from a code
# owner, so the bot can arm auto-merge but can never merge on its own.
# The last matching pattern wins. Regenerate with:
#   ./scripts/setup-github.ps1 -Owner <org-or-user> -Moderators alice,bob -Admins carol
#
# Owners listed here must have write access to txa-repo.

# Everything defaults to the volunteer moderators.
*                    @TXAVL/txa-moderators

# Package manifests - reviewed by moderators.
/manifests/          @TXAVL/txa-moderators

# Infrastructure - admins only. A PR touching these is never auto-merged.
/.github/            @TXAVL/txa-admins
/policy.txa.yaml     @TXAVL/txa-admins
/.gitattributes      @TXAVL/txa-admins
/tools/              @TXAVL/txa-admins
/scripts/            @TXAVL/txa-admins
/examples/           @TXAVL/txa-admins
/install.ps1         @TXAVL/txa-admins
