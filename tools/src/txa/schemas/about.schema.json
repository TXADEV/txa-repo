{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:txa:schema:v1:about",
  "title": "TXA About Card",
  "description": "Human-facing, translatable description of one release.",
  "type": "object",
  "additionalProperties": false,
  "required": ["txa", "kind", "ref", "lang", "name", "publisher", "author", "summary", "license"],
  "properties": {
    "txa": { "const": 1 },
    "kind": { "const": "about" },
    "ref": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]{1,39}\\.[A-Za-z0-9][A-Za-z0-9-]{0,63}@(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "lang": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Z][a-z]{3})?(-[A-Z]{2}|-[0-9]{3})?$" },
    "name": { "type": "string", "minLength": 2, "maxLength": 64 },
    "publisher": { "type": "string", "minLength": 2, "maxLength": 128 },
    "author": { "type": "string", "minLength": 2, "maxLength": 128 },
    "summary": { "type": "string", "minLength": 10, "maxLength": 160 },
    "description": { "type": "string", "maxLength": 5000 },
    "homepage": { "type": "string", "maxLength": 2048, "pattern": "^https://[^\\s]+$" },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 64 },
        "url": { "type": "string", "maxLength": 2048, "pattern": "^https://[^\\s]+$" }
      }
    }
  }
}
